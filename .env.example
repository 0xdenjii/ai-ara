# ── ARA Configuration ────────────────────────────────────────────────────────
# Copy this file to .env and customize as needed.
# All values have sensible defaults; only override what you need.
# See src/ara/config/settings.py for full field definitions and types.

# ── General ──────────────────────────────────────────────────────────────────
ARA_ENV=development                      # development | production | testing
ARA_LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
ARA_DATA_DIR=./data                      # Root data directory (resolved to absolute)

# ── LLM ──────────────────────────────────────────────────────────────────────
ARA_BACKEND_TYPE=ollama                  # "ollama" (dev) or "llamacpp" (production)
ARA_OLLAMA_BASE_URL=http://localhost:11434
ARA_LLAMACPP_BASE_URL=http://localhost:8080  # llama.cpp server (OpenAI-compatible API)
ARA_PRIMARY_MODEL=qwen3.5:35b            # Main model — Hybrid DeltaNet+MoE, 35B/3B active, ~20.5GB Q4_K_M
ARA_LONG_CONTEXT_MODEL=qwen3.5:27b       # Dense 27B for deep analysis, 262K native context
ARA_DRAFT_MODEL=qwen3:1b                 # For speculative decoding with llama.cpp
ARA_PRIMARY_MODEL_CONTEXT_LENGTH=131072   # 128K default (256K native max)
ARA_LONG_CONTEXT_LENGTH=262144            # 256K native context
ARA_TEMPERATURE=0.7                       # Qwen3.5 recommended: 0.6 for code, 0.7 general
ARA_MAX_RESPONSE_TOKENS=4096              # Increased for richer reasoning output

# ── Ollama Performance Tuning ────────────────────────────────────────────
ARA_OLLAMA_FLASH_ATTENTION=true           # Reduces peak VRAM during attention computation
ARA_OLLAMA_KV_CACHE_TYPE=q8_0            # KV cache quantization: f16, q8_0, q4_0 (q8_0 ~lossless)
ARA_OLLAMA_NUM_CTX=131072                 # Context length for Ollama requests

# ── Speculative Decoding (llama.cpp only) ────────────────────────────────
ARA_SPECULATIVE_ENABLED=false            # Enable speculative decoding
ARA_SPECULATIVE_DRAFT_MAX=16             # Max draft tokens per step
ARA_SPECULATIVE_DRAFT_MIN=5              # Min draft tokens to trigger speculation
ARA_SPECULATIVE_DRAFT_P_MIN=0.9          # Min probability for draft acceptance
ARA_SPECULATIVE_N_GPU_LAYERS_DRAFT=-1    # GPU layers for draft model (-1 = all)

# ── llama.cpp Server Options ────────────────────────────────────────────
ARA_LLAMACPP_N_GPU_LAYERS=-1             # GPU layers for primary model (-1 = all)
ARA_LLAMACPP_FLASH_ATTN=true             # Flash attention (recommended for RTX 4090)
ARA_LLAMACPP_KV_CACHE_TYPE_K=q8_0       # KV cache K quantization: f16, q8_0, q4_0 (q8_0 ~lossless)
ARA_LLAMACPP_KV_CACHE_TYPE_V=q8_0       # KV cache V quantization: f16, q8_0, q4_0 (q8_0 ~lossless)
ARA_LLAMACPP_CONTEXT_SIZE=131072         # KV cache context size
ARA_LLAMACPP_BATCH_SIZE=2048             # Batch size for prompt processing
ARA_LLAMACPP_THREADS=0                   # CPU threads (0 = auto-detect)
ARA_LLAMACPP_HOST=127.0.0.1
ARA_LLAMACPP_PORT=8080

# ── Voice: Audio ─────────────────────────────────────────────────────────────
ARA_AUDIO_SAMPLE_RATE=16000
ARA_AUDIO_CHANNELS=1
ARA_AUDIO_BLOCK_DURATION_MS=32           # 32ms = 512 samples at 16kHz (Silero VAD window)

# ── Voice: STT (Moonshine v2) ───────────────────────────────────────────────
ARA_STT_MODEL_PATH=                      # Empty = auto-discover from moonshine cache
ARA_STT_MODEL_ARCH=5                     # 5 = medium-streaming-en quantized

# ── Voice: TTS (Kokoro-82M ONNX) ────────────────────────────────────────────
ARA_TTS_MODEL_PATH=./data/models/kokoro/kokoro-v1.0.int8.onnx
ARA_TTS_VOICES_PATH=./data/models/kokoro/voices-v1.0.bin
ARA_TTS_VOICE=af_bella                   # Female voice pack
ARA_TTS_SPEED=1.0
ARA_TTS_SAMPLE_RATE=24000
ARA_TTS_LANG=en-us

# ── Voice: VAD (Silero) ─────────────────────────────────────────────────────
ARA_VAD_THRESHOLD=0.5
ARA_VAD_MIN_SPEECH_MS=250
ARA_VAD_MIN_SILENCE_MS=800
ARA_VAD_WINDOW_SIZE_SAMPLES=512          # 512 samples at 16kHz = 32ms

# ── Voice: Wake Word (openWakeWord) ─────────────────────────────────────────
ARA_WAKE_WORD_MODEL_NAMES=["hey_jarvis_v0.1"]  # JSON list — custom "hey_ara" model TBD
ARA_WAKE_WORD_THRESHOLD=0.5
ARA_WAKE_WORD_ENABLED=true
ARA_WAKE_WORD_INFERENCE_FRAMEWORK=onnx

# ── Hotkey ───────────────────────────────────────────────────────────────────
ARA_HOTKEY=ctrl+space

# ── Memory / RAG ─────────────────────────────────────────────────────────────
ARA_VECTOR_DB_PATH=./data/vector_db
ARA_GRAPH_DB_PATH=./data/graph_db/graph.sqlite
ARA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5  # 137M params, 768-dim, CPU-only
ARA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3          # Cross-encoder reranker, CPU
ARA_CHUNK_SIZE=512
ARA_CHUNK_OVERLAP=64
ARA_RETRIEVAL_TOP_K=20
ARA_RERANK_TOP_K=5

# ── Conversation Persistence ─────────────────────────────────────────────────
ARA_CONVERSATION_DB_PATH=./data/conversations.sqlite
ARA_CONVERSATION_SILENCE_TIMEOUT_S=300   # 5 min silence → end conversation
ARA_CONVERSATION_MIN_TURNS_TO_PERSIST=3

# ── Vision ───────────────────────────────────────────────────────────────────
ARA_MOONDREAM_MODEL=vikhyatk/moondream2          # 2B params, 4-bit, ~2.5GB VRAM (fallback)
ARA_QWEN_VL_MODEL=qwen3.5:35b                   # Qwen3.5 has native vision — uses primary model
ARA_VISION_ALWAYS_ON=true

# ── Internet ─────────────────────────────────────────────────────────────────
ARA_INTERNET_ENABLED=true
ARA_SEARXNG_URL=http://localhost:8888
ARA_WEB_CACHE_TTL_S=3600                # 1hr cache for web content
ARA_MAX_RESEARCH_STEPS=5

# ── Personality ──────────────────────────────────────────────────────────────
ARA_HUMOR_DIAL=7                         # 1 (supportive) → 10 (unfiltered sarcasm)
ARA_VOICE_IDENTITY=female
ARA_AUTO_DIAL_DOWN_ON_DISTRESS=true
ARA_DISTRESS_DIAL_REDUCTION=2

# User preferences (for dynamic system prompt personalization)
ARA_USER_NAME=                           # Your name — ARA uses it in conversation
ARA_PREFERRED_RESPONSE_LENGTH=normal     # concise | normal | detailed
ARA_TOPICS_TO_AVOID=[]                   # JSON list of topics to steer clear of
ARA_PREFERRED_LANGUAGES=["english"]      # JSON list — supports bilingual responses
ARA_USER_TRAITS=[]                       # JSON list — e.g. ["programmer", "night owl"]

# ── API Server ───────────────────────────────────────────────────────────────
ARA_API_HOST=127.0.0.1
ARA_API_PORT=8000
ARA_API_CORS_ORIGINS=["http://localhost:3000"]

# ── Desktop Automation ───────────────────────────────────────────────────────
ARA_DESKTOP_ENABLED=true
ARA_DESKTOP_REQUIRE_CONFIRMATION=true
ARA_DESKTOP_COMMAND_TIMEOUT_SECONDS=30.0
ARA_DESKTOP_MAX_FILE_READ_BYTES=100000
ARA_DESKTOP_SCREENSHOT_DIR=screenshots
ARA_DESKTOP_AUDIT_DB_NAME=tool_audit.sqlite

# ── Proactive Features ──────────────────────────────────────────────────────
ARA_PROACTIVE_ENABLED=true                # Master toggle for all proactive features
ARA_PROACTIVE_IDLE_CHECK_INTERVAL_S=300   # Seconds between suggestion checks
ARA_PROACTIVE_IDLE_THRESHOLD_S=600        # Seconds idle before suggesting
ARA_PROACTIVE_MAX_SUGGESTIONS_PER_HOUR=3  # Rate limit for suggestions
ARA_PROACTIVE_DAILY_RECAP_ENABLED=true    # Generate end-of-day recaps
ARA_PROACTIVE_DAILY_RECAP_HOUR=22         # Hour (0-23) to generate recap
ARA_PROACTIVE_DAILY_RECAP_MINUTE=0        # Minute (0-59) to generate recap
ARA_PROACTIVE_MIN_INTERACTIONS_FOR_RECAP=3 # Skip recap on quiet days
ARA_PROACTIVE_HABIT_DETECTION_ENABLED=true # Detect recurring behavior patterns
ARA_PROACTIVE_HABIT_MIN_OCCURRENCES=3     # Minimum occurrences to detect a habit
ARA_PROACTIVE_HABIT_LOOKBACK_DAYS=30      # Days to look back for habit patterns
ARA_PROACTIVE_MOOD_TRACKING_ENABLED=true  # Track emotional sentiment over time
ARA_PROACTIVE_MOOD_WINDOW_DAYS=7          # Rolling window for mood trends
ARA_PROACTIVE_WEEKLY_REVIEW_ENABLED=true  # Generate weekly memory reviews
ARA_PROACTIVE_WEEKLY_REVIEW_DAY=sunday    # Day of week for weekly review
ARA_PROACTIVE_WEEKLY_REVIEW_HOUR=20       # Hour to generate weekly review
ARA_PROACTIVE_MONTHLY_REVIEW_ENABLED=true # Generate monthly memory reviews
ARA_PROACTIVE_MONTHLY_REVIEW_DAY=1        # Day of month (1-28) for monthly review
ARA_PROACTIVE_NOTIFICATION_QUEUE_MAX=20   # Maximum queued notifications
ARA_PROACTIVE_NOTIFICATION_TTL_HOURS=24   # Hours before notifications expire
ARA_PROACTIVE_NOTIFICATION_COOLDOWN_S=120 # Minimum seconds between deliveries

# ── MCP Integration ──────────────────────────────────────────────────────────
ARA_MCP_ENABLED=true                     # Master toggle for MCP server connections
ARA_MCP_AUTO_DISCOVER=true               # Auto-discover from Claude Desktop / Antigravity configs
ARA_MCP_CONNECT_TIMEOUT_S=30.0           # Timeout for connecting to each server
ARA_MCP_MAX_RETRIES=2                    # Retries per server before giving up

# ── Obsidian Integration ─────────────────────────────────────────────────────
ARA_OBSIDIAN_ENABLED=true                 # Master toggle for Obsidian integration
ARA_OBSIDIAN_API_URL=https://127.0.0.1:27124  # Obsidian Local REST API endpoint
ARA_OBSIDIAN_API_KEY=                     # API key from Obsidian Local REST API plugin
ARA_OBSIDIAN_VERIFY_SSL=false             # Local REST API uses self-signed certificates

# Vault structure (relative to vault root)
ARA_OBSIDIAN_DAILY_NOTE_FOLDER=10_Journal/Daily  # Daily notes folder
ARA_OBSIDIAN_DAILY_NOTE_PATTERN={year}/{mm}-{month}/{date}.md  # Pattern: YYYY/MM-Month/YYYY-MM-DD.md
ARA_OBSIDIAN_INBOX_PATH=00_Inbox/RAM.md   # Active todos / scratch pad
ARA_OBSIDIAN_EFFORTS_FOLDER=20_Efforts    # Projects folder

# Sync engine
ARA_OBSIDIAN_SYNC_INTERVAL_S=300          # Check for vault changes (seconds)
ARA_OBSIDIAN_SYNC_ON_BOOT=true            # Full sync when ARA starts
ARA_OBSIDIAN_SYNC_LOOKBACK_DAYS=7         # Days to check for changes on boot

# Writer (ARA writing to daily notes)
ARA_OBSIDIAN_WRITE_TO_ARA_LOG=true        # Write to dedicated ARA's LOG section
ARA_OBSIDIAN_WRITE_TO_OPS_LOG=true        # Also write key items to Q callouts
ARA_OBSIDIAN_ARA_LOG_HEADING=## ARA's LOG # Section heading in daily note
ARA_OBSIDIAN_VOICE=first_person           # first_person | third_person | factual

# Morning briefing
ARA_OBSIDIAN_MORNING_BRIEFING_ENABLED=true
ARA_OBSIDIAN_MORNING_BRIEFING_HOUR=7      # Hour (0-23) for morning briefing
ARA_OBSIDIAN_END_OF_DAY_RECAP_ENABLED=true
ARA_OBSIDIAN_END_OF_DAY_RECAP_HOUR=23     # Hour (0-23) for end-of-day recap

# Habit tracking from protocol checklists
ARA_OBSIDIAN_PROTOCOL_TRACKING_ENABLED=true
ARA_OBSIDIAN_PROTOCOL_STREAK_THRESHOLD_PCT=80.0  # Score above this = streak day

# RAG ingestion
ARA_OBSIDIAN_INGEST_ON_SYNC=true          # Auto-ingest changed notes into vector store
ARA_OBSIDIAN_INGEST_BATCH_SIZE=10         # Notes per batch for ingestion
