# ── ARA Configuration ────────────────────────────────────────────────────────
# Copy this file to .env and customize as needed.
# All values have sensible defaults; only override what you need.

# ── General ──────────────────────────────────────────────────────────────────
ARA_ENV=development
ARA_LOG_LEVEL=INFO
ARA_DATA_DIR=./data

# ── LLM ──────────────────────────────────────────────────────────────────────
ARA_OLLAMA_BASE_URL=http://localhost:11434
ARA_PRIMARY_MODEL=qwen3:30b-a3b
ARA_LONG_CONTEXT_MODEL=qwen3:14b
ARA_DRAFT_MODEL=qwen3:1b
ARA_PRIMARY_MODEL_CONTEXT_LENGTH=32768
ARA_LONG_CONTEXT_LENGTH=131072
ARA_TEMPERATURE=0.8
ARA_MAX_RESPONSE_TOKENS=2048

# ── Voice ────────────────────────────────────────────────────────────────────
ARA_AUDIO_SAMPLE_RATE=16000
ARA_AUDIO_CHANNELS=1
ARA_AUDIO_BLOCK_DURATION_MS=30

# STT (Moonshine v2)
ARA_STT_MODEL_PATH=./data/models/moonshine-v2-medium
ARA_STT_BEAM_SIZE=1

# TTS (Kokoro-82M)
ARA_TTS_MODEL_PATH=./data/models/kokoro-82m
ARA_TTS_VOICE=af_bella
ARA_TTS_SPEED=1.0
ARA_TTS_SAMPLE_RATE=24000

# VAD (Silero)
ARA_VAD_THRESHOLD=0.5
ARA_VAD_MIN_SPEECH_MS=250
ARA_VAD_MIN_SILENCE_MS=800

# Wake Word (openWakeWord)
ARA_WAKE_WORD_MODEL_PATH=./data/models/openwakeword
ARA_WAKE_WORD_THRESHOLD=0.5
ARA_WAKE_WORD_ENABLED=true

# Hotkey
ARA_HOTKEY=ctrl+space

# ── Memory / RAG ─────────────────────────────────────────────────────────────
ARA_VECTOR_DB_PATH=./data/vector_db
ARA_GRAPH_DB_PATH=./data/graph_db/graph.sqlite
ARA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
ARA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ARA_CHUNK_SIZE=512
ARA_CHUNK_OVERLAP=64
ARA_RETRIEVAL_TOP_K=20
ARA_RERANK_TOP_K=5

# ── Conversation Persistence ─────────────────────────────────────────────────
ARA_CONVERSATIONS_DB_PATH=./data/conversations.sqlite
ARA_CONVERSATION_SILENCE_TIMEOUT_S=300
ARA_CONVERSATION_MIN_TURNS_TO_PERSIST=3

# ── Vision ───────────────────────────────────────────────────────────────────
ARA_MOONDREAM_MODEL=vikhyatk/moondream2
ARA_QWEN_VL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
ARA_VISION_ALWAYS_ON=true

# ── Internet ─────────────────────────────────────────────────────────────────
ARA_INTERNET_ENABLED=true
ARA_SEARXNG_URL=http://localhost:8888
ARA_WEB_CACHE_TTL_S=3600
ARA_MAX_RESEARCH_STEPS=5

# ── Personality ──────────────────────────────────────────────────────────────
ARA_HUMOR_DIAL=7
ARA_VOICE_IDENTITY=female
ARA_AUTO_DIAL_DOWN_ON_DISTRESS=true
ARA_DISTRESS_DIAL_REDUCTION=2

# ── API Server ───────────────────────────────────────────────────────────────
ARA_API_HOST=127.0.0.1
ARA_API_PORT=8000
ARA_API_CORS_ORIGINS=["http://localhost:3000"]

# ── Desktop Automation ───────────────────────────────────────────────────────
ARA_DESKTOP_ENABLED=true
ARA_DESKTOP_REQUIRE_CONFIRMATION=true
